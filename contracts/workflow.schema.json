          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CapabilityNode"
          },
          {
            "$ref": "#/$defs/AgentNode"
          },
          {
            "$ref": "#/$defs/DecisionNode"
          },
          {
            "$ref": "#/$defs/ApprovalNode"
          }
        ]
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/EdgeSpec"
      },
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "entrypoint",
    "nodes",
    "edges"
  ],
  "title": "WorkflowSpec",
  "type": "object"
