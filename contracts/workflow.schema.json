          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "const": "$end",
              "type": "string"
            }
          ],
          "title": "Target"
        },
        "when": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
