{
  "$defs": {
    "AgentNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ui_stage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ui Stage Id"
        },
        "inputs": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "literal": "#/$defs/Constant",
                "ref": "#/$defs/Reference"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Reference"
              },
              {
                "$ref": "#/$defs/Constant"
              }
            ]
          },
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "pattern": "^\\$\\.data(\\.[A-Za-z_][A-Za-z0-9_]*)+$",
            "type": "string"
          },
          "title": "Outputs",
          "type": "object"
        },
        "type": {
          "const": "pi",
          "default": "pi",
          "title": "Type",
          "type": "string"
        },
        "kind": {
          "const": "agent_task",
          "default": "agent_task",
          "title": "Kind",
          "type": "string"
        },
        "pi": {
          "$ref": "#/$defs/PiConfig"
        },
        "goal": {
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "input_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "goal"
      ],
      "title": "AgentNode",
      "type": "object"
    },
